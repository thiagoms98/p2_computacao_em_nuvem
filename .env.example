# Google Cloud: crie uma Service Account, habilite Google Drive API,
# compartilhe a pasta do Drive com o e-mail da service account.
# Informe o JSON inteiro em uma linha ou use a versão Base64 abaixo.
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_DRIVE_FOLDER_ID=

# Azure Storage. Crie previamente um container com nome em minúsculas.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=aluno-seu-nome

# Protege a interface e as rotas da API com autenticação HTTP Basic.
APP_ACCESS_PASSWORD=
